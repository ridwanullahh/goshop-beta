{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["./apps/api/src/*"]
    }
  },
  "include": ["./api/**/*.ts", "../apps/api/src/handlers/**/*.ts", "../apps/api/src/router.ts", "../apps/api/src/lib/env.ts", "../apps/api/src/lib/lightbase-client.ts", "../apps/api/src/lib/auth.ts", "../apps/api/src/lib/provider/**/*.ts", "../apps/api/src/lib/email/**/*.ts", "../apps/api/src/lib/schema.ts"]
}
