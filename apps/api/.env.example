# GoShop API (apps/api) — Environment Template
# BismiLLAH Ar-Rahman Ar-Roheem. Copy this file to `apps/api/.env` and fill in real values.
# The Astro dev process (cwd: apps/api) loads this file directly so the backend has the vars.
# This file is safe to commit (NO secrets). The `apps/api/.env` file is gitignored.

# Database provider: lightbase (default) | sqlite
DB_PROVIDER=lightbase

# Lightbase (core /api/v1)
LIGHTBASE_BASE_URL=https://your-lightbase-host
LIGHTBASE_API_KEY=lb_live_xxx
LIGHTBASE_PROJECT_ID=your-project-id

# Auth
JWT_SECRET=change_me

# App public URL (payment redirects)
APP_URL=

# CORS (comma-separated; empty = permissive)
CORS_ORIGINS=

# Payments (optional)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Legacy SQLite (only when DB_PROVIDER=sqlite)
SQLITE_DB_PATH=

# ---- Email (Gmail) ----
# Primary: SMTP app password. Create one at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Fallback: OAuth2 refresh-token flow (used only if SMTP app password is not set).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Sender display name shown in the From header.
EMAIL_FROM_NAME=GoShop
# Domain used for the SMTP HELO/EHLO name and Message-ID (defaults to the GMAIL_USER domain).
EMAIL_DOMAIN=goshop.com
# Reply-To address (support inbox).
SUPPORT_EMAIL=support@goshop.com
# Admin inbox that receives contact-form / store-approval / dispute notifications.
ADMIN_EMAIL=admin@goshop.com
# Public URL of the frontend app — used to build absolute links inside emails.
APP_URL=
# Optional: URL of a hosted logo image (PNG, ~140x40). If empty, a text logo "GoShop" is used.
APP_LOGO_URL=
# Optional: company address shown in the email footer.
COMPANY_ADDRESS=GoShop Inc., 123 Marketplace Ave, Suite 100, San Francisco, CA 94103, USA
# Mailto address used in the List-Unsubscribe header.
UNSUBSCRIBE_EMAIL=unsubscribe@goshop.com
# Test recipient for `npm run test:email` (no real email is sent unless Gmail is configured).
TEST_EMAIL_TO=
