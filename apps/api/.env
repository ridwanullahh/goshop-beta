# GoShop Backend API Configuration

# JWT Secret (change in production!)
JWT_SECRET=goshop_jwt_secret_change_in_production_2024_super_secret_key

# Database
SQLITE_DB_PATH=./data/goshop.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:4173,http://localhost:3001

# Application
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Payment Gateways (configure with your keys)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_key
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
