# GoShop Beta — environment template (safe to commit). Copy to `.env` and fill in real values.
# BismiLLAH Ar-Rahman Ar-Roheem.

# Database provider: lightbase (default, recommended) | sqlite (legacy better-sqlite3)
DB_PROVIDER=lightbase

# Lightbase (core /api/v1)
LIGHTBASE_BASE_URL=https://your-lightbase-host
LIGHTBASE_API_KEY=lb_live_xxx
LIGHTBASE_PROJECT_ID=your-project-id

# Auth
JWT_SECRET=change_me

# App public URL (used for payment redirect URLs; leave empty in dev)
APP_URL=

# Frontend (public). Leave VITE_API_URL empty to use relative /api paths (recommended).
VITE_API_URL=
VITE_APP_NAME=GoShop
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# CORS (comma-separated origins; empty = permissive)
CORS_ORIGINS=

# Payments (optional)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Legacy SQLite (only used when DB_PROVIDER=sqlite)
SQLITE_DB_PATH=
