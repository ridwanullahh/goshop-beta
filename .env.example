# GoShop Beta — Environment Template
# BismiLLAH Ar-Rahman Ar-Roheem. Copy this file to `.env` and fill in real values.
# This file is safe to commit (it contains NO secrets). The `.env` file is gitignored.

# ---- Database provider ----
# lightbase (default, recommended) | sqlite (legacy, local better-sqlite3)
DB_PROVIDER=lightbase

# ---- Lightbase (core /api/v1) ----
# Get these from your Lightbase project dashboard.
LIGHTBASE_BASE_URL=https://your-lightbase-host
LIGHTBASE_API_KEY=lb_live_xxx
LIGHTBASE_PROJECT_ID=your-project-id

# ---- Auth ----
# Change this to a long random string in production.
JWT_SECRET=change_me

# ---- App ----
# Public URL used for payment redirect URLs. Leave empty in dev.
APP_URL=

# ---- Frontend (public, no secrets) ----
# Leave VITE_API_URL empty to use relative /api paths (recommended; routes through the gateway/proxy).
VITE_API_URL=
VITE_APP_NAME=GoShop
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- CORS ----
# Comma-separated origins allowed to call the API. Empty = permissive (all origins).
CORS_ORIGINS=

# ---- Payments (optional) ----
# Leave empty to disable a gateway. The wallet and COD methods always work.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---- Legacy SQLite (only used when DB_PROVIDER=sqlite) ----
# Path to the local SQLite database file. Defaults to ../../data/goshop.db relative to apps/api.
SQLITE_DB_PATH=

# ---- Email (Gmail) ----
# Primary: SMTP app password. Create one at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Fallback: OAuth2 refresh-token flow (used only if SMTP app password is not set).
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Sender display name shown in the From header (e.g. "GoShop").
EMAIL_FROM_NAME=GoShop
# Domain used for the SMTP HELO/EHLO name and Message-ID (defaults to the GMAIL_USER domain).
EMAIL_DOMAIN=goshop.com
# Reply-To address (support inbox).
SUPPORT_EMAIL=support@goshop.com
# Admin inbox that receives contact-form / store-approval / dispute notifications.
ADMIN_EMAIL=admin@goshop.com
# Public URL of the frontend app — used to build absolute links inside emails.
APP_URL=
# Optional: URL of a hosted logo image (PNG, ~140x40). If empty, a text logo "GoShop" is used.
APP_LOGO_URL=
# Optional: company address shown in the email footer.
COMPANY_ADDRESS=GoShop Inc., 123 Marketplace Ave, Suite 100, San Francisco, CA 94103, USA
# Mailto address used in the List-Unsubscribe header.
UNSUBSCRIBE_EMAIL=unsubscribe@goshop.com
# Test recipient for `npm run test:email` (no real email is sent unless Gmail is configured).
TEST_EMAIL_TO=
